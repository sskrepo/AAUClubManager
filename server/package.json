{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "AAUClubManager backend API server",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts --watch src --ext ts",
    "dev:workers": "nodemon --exec tsx src/workers/index.ts --watch src/workers --ext ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "queue:test": "tsx src/scripts/queue-test.ts",
    "notify:test:email": "tsx src/scripts/notify-test-email.ts",
    "notify:test:whatsapp": "tsx src/scripts/notify-test-whatsapp.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.22.0",
    "bullmq": "^5.21.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-openapi-validator": "^5.3.7",
    "ioredis": "^5.3.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "pino": "^9.4.0",
    "pino-http": "^10.2.0",
    "resend": "^3.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.7.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.0"
  }
}
