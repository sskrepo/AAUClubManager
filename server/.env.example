# AAUClubManager Server — Environment Variables
# Copy this file to server/.env and fill in values.
# server/.env is gitignored. NEVER commit real secrets.
#
# Source of truth for credentials: .env.local at the repo root (also gitignored).
# Local dev: copy .env.local values here, or symlink.

# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database — local Docker: postgres://postgres:postgres@localhost:5432/aauclub_dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aauclub_dev

# Redis — local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Clerk — get from https://dashboard.clerk.com/
# Test keys (prefixed pk_test_ / sk_test_) are safe for dev.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Resend — get from https://resend.com/
# RESEND_FROM_EMAIL requires a verified domain in the Resend dashboard.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# 360dialog WhatsApp Business API
# Sandbox (dev): https://waba-sandbox.360dialog.io/v1 (free, 200 msg cap)
# Production: https://waba-v2.360dialog.io/v2 (requires Meta Business verification)
DIALOG360_API_KEY=your-360dialog-api-key
DIALOG360_BASE_URL=https://waba-sandbox.360dialog.io/v1
# Required only for production (not sandbox):
# DIALOG360_WHATSAPP_FROM=+15551234567

# Dev test targets (used by notify:test:* scripts only)
TEST_EMAIL=your-email@example.com
TEST_WHATSAPP_NUMBER=+15551234567
